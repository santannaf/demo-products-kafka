<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects run as executables. -->
    <OutputType>Exe</OutputType>
    <!--
      Without this the executable's entry point is xUnit's OWN console runner, which does not understand
      the arguments `dotnet test` passes it (a `nologo` flag, plus `server dotnettestcli` and a
      `dotnet-test-pipe` path, each in double-dash form). It answers `error: unknown option` and exits 3,
      which `dotnet test` reports as "Zero tests ran" — a command that looks like it ran the suite and
      asserted nothing. Running the executable directly still worked, which is what made it easy to miss.
    -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <RootNamespace>DemoProducts.UnitTests</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DemoProducts.Domain\DemoProducts.Domain.csproj" />
    <ProjectReference Include="..\..\src\DemoProducts.Application\DemoProducts.Application.csproj" />
    <ProjectReference Include="..\..\src\DemoProducts.Infrastructure\DemoProducts.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

</Project>
