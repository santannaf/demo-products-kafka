<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DemoProducts.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DemoProducts.Application\DemoProducts.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Apache.Avro" />
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Confluent.SchemaRegistry" />
    <PackageReference Include="Confluent.SchemaRegistry.Serdes.Avro" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <!--
    The .avsc is the canonical schema, shipped alongside the code so it is reviewable next to it, and
    embedded so the producing side can register the SAME file the code generator consumes. A string
    constant would be a second copy that nothing compares against the first.

    LogicalName is pinned rather than left to the default, which derives from the directory path: moving
    the file would otherwise rename the resource and break the lookup at runtime instead of at build.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Messaging\Kafka\Avro\Schemas\product-created.avsc"
                      LogicalName="DemoProducts.Infrastructure.Avro.product-created.avsc" />
  </ItemGroup>

  <Import Project="Messaging\Kafka\Avro\Avro.targets" />

  <!-- The delivery protocol and the options validator are internal; their tests are their interface. -->
  <ItemGroup>
    <InternalsVisibleTo Include="DemoProducts.UnitTests" />
  </ItemGroup>

</Project>
