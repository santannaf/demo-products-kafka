{
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "demo-products-kafka-consumer",
    "Producer": {
      "Acks": "All",
      "EnableIdempotence": true,
      "MessageTimeoutMs": 30000,
      "MaxRetries": 3,
      "CompressionType": "Snappy",
      "Partitioner": "ConsistentRandom"
    },
    "Consumer": {
      "GroupId": "demo-products-kafka-consumer",
      "AutoOffsetReset": "Latest",
      "EnableAutoCommit": false,
      "SessionTimeoutMs": 45000,
      "MaxPollIntervalMs": 300000,
      "MaxPollRecords": 1000,
      "FetchMinBytes": 200000,
      "FetchWaitMaxMs": 400,
      "RetryDelayMs": 5000,
      "MaxAttemptsPerRecord": 2,
      "EnableAvroReader": false,
      "AsyncAck": false,
      "EnableBatchListener": false
    },
    "SchemaRegistry": {
      "Url": "http://localhost:18081",
      "AutoRegisterSchemas": true
    },
    "Topics": {
      "ProductCreated": "product-created"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "OutputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{ThreadId}] {ShortLevel} {ShortContext} - {Message:lj}{NewLine}{Exception}"
  }
}
